# Backend Environment Variables
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
MOCK_STORE_URL=https://demo.inelabteamdev.com

# Cron authentication for POST /api/scrape/run
CRON_SECRET=replace-with-a-strong-random-secret

# Optional: protect manual scrape in production
# MANUAL_SCRAPE_SECRET=

# Scraper timeouts and retries
SCRAPE_NAVIGATION_TIMEOUT_MS=20000
SCRAPE_REVEAL_TIMEOUT_MS=25000
SCRAPE_MAX_RETRIES=3
SCRAPE_RETRY_BASE_DELAY_MS=1000
HTTP_TIMEOUT_MS=12000

# Headed Playwright (for local demo / screen recording)
HEADED=false
SLOW_MO_MS=250

# Failure simulation for demos (none | slow | http-error | timeout | retry-then-success | fail)
SCRAPE_SIMULATE=none

# Catalog cache
CATALOG_TTL_MS=600000
CATALOG_PAGE_SIZE=50

# Supabase PostgreSQL (Required for Production)
# Leave empty to fall back to local JSON store in dev mode
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
