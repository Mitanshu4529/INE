# Copy to backend/.env and frontend/.env as needed.
# Never commit real credentials.

# --- Backend (Render / local) ---
NODE_ENV=development
PORT=3001
MOCK_STORE_URL=https://demo.inelabteamdev.com
FRONTEND_ORIGIN=http://localhost:5173

# Cron authentication for POST /api/scrape/run
CRON_SECRET=replace-with-a-long-random-secret

# Optional: protect manual scrape in production
# MANUAL_SCRAPE_SECRET=

# Scraper timeouts and retries
SCRAPE_NAVIGATION_TIMEOUT_MS=20000
SCRAPE_REVEAL_TIMEOUT_MS=25000
SCRAPE_MAX_RETRIES=3
SCRAPE_RETRY_BASE_DELAY_MS=1000
HTTP_TIMEOUT_MS=12000

# Headed Playwright (local demo / recording)
HEADED=false
SLOW_MO_MS=250

# Failure simulation for demos (never used in production cron)
# none | slow | http-error | timeout | retry-then-success | fail
SCRAPE_SIMULATE=none

# Catalog cache
CATALOG_TTL_MS=600000
CATALOG_PAGE_SIZE=50

# Supabase (required for production). Leave empty to use local JSON store.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key



# --- Frontend (Vercel / local Vite) ---
# Put this in frontend/.env
VITE_API_BASE_URL=http://localhost:3001/api
